    <NMakeCleanCommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)build.ps1" -Configuration $(Configuration) -ConfigFile "$(Tiny3DConfigFile)" -Clean</NMakeCleanCommandLine>
    <NMakeOutput>$(OutDir)tiny3d_project.exe</NMakeOutput>
    <NMakeIncludeSearchPath>$(ProjectDir)include;$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
    <NMakePreprocessorDefinitions>_WIN32;$(NMakePreprocessorDefinitions)</NMakePreprocessorDefinitions>
    <AdditionalOptions>/std:c++17 $(AdditionalOptions)</AdditionalOptions>
    <LocalDebuggerCommand>$(OutDir)tiny3d_project.exe</LocalDebuggerCommand>
